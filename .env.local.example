# Copy this file to .env.local (gitignored) and fill in your real values.
# These are exposed to the browser (NEXT_PUBLIC_) on purpose — the Storefront
# API token is a public, client-safe token by design, unlike the Admin API token.

# Your store's *.myshopify.com domain (not a custom domain, even if you have one)
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com

# Shopify Admin -> Settings -> Apps and sales channels -> Develop apps ->
# create an app -> Storefront API -> enable scopes -> Install -> copy the
# Storefront API access token (NOT the Admin API token)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Optional, defaults to 2025-01 if omitted
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01
